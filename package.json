{
    "name": "functional-cursors",
    "displayName": "Functional Cursors",
    "description": "Change your cursor content on the fly with any JavaScript",
    "version": "0.1.0",
    "publisher": "sporiley",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:extension.jsCursors"
    ],
    "icon": "f-cursors.png",
    "main": "./extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.jsCursors",
                "title": "Functional Cursors: apply a JavaScript function at every cursor (jscursor)"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Functional Cursors",
            "properties": {
                "functional-cursors.functions": {
                    "type": "object",
                    "default": {},
                    "description": "Helper functions available inside the expression, as name -> JavaScript source. Example: {\"getDOW\": \"i => ['Mon','Tue'][i % 2]\"}",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "repository": {
        "type": "github",
        "url": "https://github.com/stevengeeky/functional-cursors"
    },
    "scripts": {
        "test": "node --test \"test/*.test.js\"",
        "lint": "eslint extension.js lib test"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.75.0",
        "eslint": "^8.57.0"
    },
    "bugs": {
        "url": "https://github.com/stevengeeky/functional-cursors/issues"
    }
}
